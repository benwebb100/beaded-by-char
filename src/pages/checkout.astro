---
import Base from '../layouts/Base.astro';
---
<Base title="Checkout | BeadedByChar">
  <section class="msg">
    <h1>Checkout isn't connected yet</h1>
    <p>This is the test version of the new site. Card payments get switched on in the next step.</p>
    <a href="/cart">Back to cart</a>
  </section>
</Base>

<style>
  .msg { max-width: 640px; margin: 0 auto; padding: 100px 20px; text-align: center; font-family: 'Open Sans', sans-serif; }
  h1 { font: 700 28px 'Urbanist', sans-serif; margin: 0 0 12px; }
  a { display: inline-block; margin-top: 20px; padding: 10px 24px; background: var(--pink); color: #fff; font-weight: 700; }
</style>

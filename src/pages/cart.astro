---
import Base from '../layouts/Base.astro';
const checkoutEndpoint = import.meta.env.PUBLIC_CHECKOUT_ENDPOINT ?? '';
---
<Base title="View Cart | BeadedByChar">
  <section class="cart" data-endpoint={checkoutEndpoint}>
    <div class="lines">
      <p class="heading">My cart</p>
      <div class="empty" data-empty>
        <img src="/img/site/icons/empty-cart.svg" alt="" width="300" height="225" />
        <b>Your cart is empty</b>
        <a href="/collections" class="continue"><img src="/img/site/icons/arrow-right.svg" alt="" width="20" height="20" /> Continue Shopping</a>
      </div>
      <ul data-list hidden></ul>
    </div>
    <aside class="summary">
      <div class="row"><p>Subtotal</p><p data-subtotal>AU$0.00</p></div>
      <div class="row total"><p>Total</p><p class="big" data-total>AU$0.00</p></div>
      <p class="note">Shipping calculated at checkout</p>
      <button type="button" class="checkout" data-checkout disabled>Checkout</button>
      <p class="error" data-error hidden></p>
    </aside>
  </section>
  <template id="line">
    <li class="line">
      <a class="thumb" data-link><img data-img alt="" width="80" height="80" /></a>
      <div class="meta">
        <a class="name" data-link data-name></a>
        <p class="variant" data-variant></p>
        <p class="unit" data-unit></p>
      </div>
      <div class="qty">
        <button type="button" data-minus aria-label="Decrease quantity">−</button>
        <span data-qty></span>
        <button type="button" data-plus aria-label="Increase quantity">+</button>
      </div>
      <p class="line-total" data-line-total></p>
      <button type="button" class="remove" data-remove aria-label="Remove">×</button>
    </li>
  </template>
</Base>

<style>
  .cart { max-width: 1160px; margin: 0 auto; padding: 55px 80px 80px; display: grid; grid-template-columns: 588px 332px; column-gap: 80px; font-family: 'Open Sans', sans-serif; }
  .heading { font-size: 16px; margin: 0; padding: 0 0 12px; border-bottom: 2px solid var(--line); }
  .empty { display: flex; flex-direction: column; align-items: center; padding-top: 1px; }
  .empty > img { width: 300px; height: 225px; }
  .empty b { font-size: 16px; margin: 16px 0 30px; }
  .continue { width: 294px; height: 43px; background: #efefef; display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 16px; }
  ul { list-style: none; margin: 0; padding: 0; }
  .line { display: grid; grid-template-columns: 80px 1fr auto 90px 28px; align-items: center; gap: 16px; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .thumb img { width: 80px; height: 80px; object-fit: cover; }
  .name { font-size: 15px; font-weight: 600; }
  .variant, .unit { font-size: 13px; color: var(--muted); margin: 4px 0 0; }
  .qty { display: flex; align-items: center; border: 1px solid var(--line); border-radius: 8px; height: 36px; background: #fff; }
  .qty button { width: 32px; height: 34px; background: none; border: 0; font-size: 18px; }
  .qty span { min-width: 24px; text-align: center; font-size: 14px; }
  .line-total { text-align: right; font-size: 15px; margin: 0; }
  .remove { background: none; border: 0; font-size: 22px; color: var(--muted); }

  .summary { padding-top: 15px; }
  .row { display: flex; justify-content: space-between; align-items: center; }
  .row p { margin: 0; font-size: 16px; }
  .row:first-child { padding-bottom: 15px; }
  .total { border-top: 1px solid var(--line); padding: 16px 0; }
  .big { font-size: 24px !important; font-weight: 500; }
  .note { font-size: 13px; color: var(--muted); margin: 0 0 10px; }
  .checkout { width: 100%; height: 46px; background: var(--pink); color: #fff; border: 0; font-weight: 700; font-size: 16px; }
  .checkout:disabled { opacity: 0.55; cursor: default; }
  .error { color: #b42318; font-size: 14px; margin-top: 10px; }

  @media (max-width: 1100px) {
    .cart { grid-template-columns: 1fr; padding: 40px 20px 60px; row-gap: 40px; }
  }
  @media (max-width: 560px) {
    .line { grid-template-columns: 64px 1fr 28px; grid-template-areas: 'img meta rm' 'img qty total'; row-gap: 10px; }
    .thumb { grid-area: img; } .thumb img { width: 64px; height: 64px; }
    .meta { grid-area: meta; } .qty { grid-area: qty; justify-self: start; }
    .line-total { grid-area: total; } .remove { grid-area: rm; }
    .empty > img { width: 240px; height: auto; }
  }
</style>

<script>
  import { getCart, setQty, removeLine, cartSubtotal } from '../scripts/cart';

  const list = document.querySelector<HTMLUListElement>('[data-list]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const tpl = document.querySelector<HTMLTemplateElement>('#line')!;
  const checkout = document.querySelector<HTMLButtonElement>('[data-checkout]')!;
  const error = document.querySelector<HTMLElement>('[data-error]')!;
  const endpoint = document.querySelector<HTMLElement>('.cart')!.dataset.endpoint;
  const aud = (n: number) => `AU$${n.toFixed(2)}`;

  function render() {
    const lines = getCart();
    empty.hidden = lines.length > 0;
    list.hidden = lines.length === 0;
    list.replaceChildren(...lines.map(l => {
      const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
      li.querySelectorAll<HTMLAnchorElement>('[data-link]').forEach(a => (a.href = l.url));
      const img = li.querySelector<HTMLImageElement>('[data-img]')!;
      if (l.image) img.src = l.image; else img.remove();
      li.querySelector('[data-name]')!.textContent = l.name;
      li.querySelector('[data-variant]')!.textContent = l.variant;
      li.querySelector('[data-unit]')!.textContent = aud(l.amount);
      li.querySelector('[data-qty]')!.textContent = String(l.qty);
      li.querySelector('[data-line-total]')!.textContent = aud(l.amount * l.qty);
      li.querySelector('[data-minus]')!.addEventListener('click', () => setQty(l.priceId, l.qty - 1));
      li.querySelector('[data-plus]')!.addEventListener('click', () => setQty(l.priceId, l.qty + 1));
      li.querySelector('[data-remove]')!.addEventListener('click', () => removeLine(l.priceId));
      return li;
    }));
    const sub = aud(cartSubtotal());
    document.querySelector('[data-subtotal]')!.textContent = sub;
    document.querySelector('[data-total]')!.textContent = sub;
    checkout.disabled = lines.length === 0;
  }

  checkout.addEventListener('click', async () => {
    if (!endpoint) { location.href = '/checkout'; return; }
    checkout.disabled = true;
    error.hidden = true;
    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ lines: getCart().map(l => ({ priceId: l.priceId, qty: l.qty })) }),
      });
      const body = await res.json();
      if (!res.ok || !body.url) throw new Error(body.error ?? 'Checkout failed');
      location.href = body.url;
    } catch (e) {
      error.textContent = e instanceof Error ? e.message : 'Checkout failed. Please try again.';
      error.hidden = false;
      checkout.disabled = false;
    }
  });

  window.addEventListener('cart:change', render);
  window.addEventListener('storage', render);
  render();
</script>

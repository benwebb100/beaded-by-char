---
// Social links copy the live site, where Instagram and TikTok point at the platforms' home pages.
// Swap in Charlee's profile URLs once we have them.
const social = [
  { name: 'Instagram', icon: 'instagram', href: 'https://instagram.com' },
  { name: 'TikTok', icon: 'tiktok', href: 'https://tiktok.com' },
  { name: 'Email', icon: 'mail', href: 'mailto:info@beadedbychar.com.au' },
  { name: 'Website', icon: 'website', href: '/' },
];
---
<footer class="foot">
  <div class="cols">
    <div class="col social">
      <p class="small">Social Media</p>
      <div class="icons">
        {social.map(s => (
          <a href={s.href} aria-label={s.name} target={s.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
            <img src={`/img/site/icons/${s.icon}.svg`} alt="" width="24" height="24" />
          </a>
        ))}
      </div>
    </div>
    <div class="col quick">
      <h3 style="color:#000">Quick Links</h3>
      <a href="/">Home</a>
      <a href="/collections">Shop</a>
      <a href="/about">About</a>
    </div>
    <div class="col contact">
      <h3>Contact Us</h3>
      <p>Melbourne, Australia</p>
      <p>0483968933</p>
      <p class="email"><a href="mailto:info@beadedbychar.com.au">info@beadedbychar.com.au</a></p>
    </div>
    <div class="col legal">
      <h3>Legal</h3>
      <a href="/privacy-policy">Privacy Policy</a>
      <a href="/terms-of-service">Terms &amp; Conditions</a>
    </div>
  </div>
  <hr class="divider" />
  <p class="copy">© 2024 BeadedByChar.com.au<br />All Rights Reserved</p>
</footer>

<style>
  .foot { background: var(--off); padding: 38px 0 30px; }
  .cols { max-width: 1160px; margin: 0 auto; display: grid; grid-template-columns: 394px 250px 252px 1fr; color: var(--grey); }
  .col { display: flex; flex-direction: column; align-items: flex-start; }
  .col h3 { font: 700 18px/18px var(--f-head); margin: 0 0 30px; color: var(--grey); }
  .col a, .col p { font: 400 16px/16px var(--f-body); }
  .col > a { margin: 0 0 9px; padding: 3px 0; }
  .col p { margin: 0 0 15px; padding: 0; }
  .col .email { font-size: 15px; }
  .quick { padding-top: 10px; }
  .contact { padding-top: 16px; }
  .contact h3 { margin-bottom: 33px; }
  .social { padding: 42px 0 0 40px; }
  .social .small { font-size: 14px; line-height: 18.2px; margin: 0 0 10px; padding: 0; }
  .icons { display: flex; }
  .icons a { padding: 10px 16px; margin: 0; }
  .icons img { width: 24px; height: 24px; }
  .divider { max-width: 1160px; margin: 38px auto 0; color: var(--grey); }
  .copy { text-align: center; font: 400 14px/18.2px var(--f-body); color: rgba(0, 0, 0, 0.5); margin: 35px 0 0; }

  @media (max-width: 1200px) {
    .cols { grid-template-columns: 1.4fr 1fr 1fr 1fr; padding: 0 20px; }
    .divider { margin-left: 20px; margin-right: 20px; }
  }
  @media (max-width: 767px) {
    .foot { padding-top: 30px; }
    .cols { grid-template-columns: 1fr; padding: 0 16px; }
    .col { padding: 0; margin-bottom: 18px; }
    .col h3 { margin-bottom: 26px; }
    .social { padding: 0; }
    .icons a { padding: 10px 16px 10px 16px; }
    .icons a:first-child { padding-left: 16px; }
    .divider { margin: 40px 10px 0; }
  }
</style>
